# Respaldo completo del almacén; lo dispara gymtracker-respaldo.timer.
[Unit]
Description=Respaldo completo de GymTracker

[Service]
Type=oneshot
WorkingDirectory=%h/gymtracker
EnvironmentFile=%h/gymtracker/.env
ExecStart=/usr/bin/bash deploy/respaldo.sh %h/respaldos-completos
# Se quedan los 30 más recientes: un mes de días.
ExecStartPost=/usr/bin/bash -c 'ls -1t %h/respaldos-completos/gymtracker-*.tar.gz* 2>/dev/null | tail -n +31 | xargs -r rm -f'
