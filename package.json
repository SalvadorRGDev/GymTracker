{
  "name": "sigir-fitness",
  "version": "0.2.0",
  "private": true,
  "description": "Series efectivas por grupo muscular y semana: lo planeado contra lo ejecutado.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "formatea": "biome check --write .",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "npm run build:api && node --env-file-if-exists=.env --watch-path=dist dist/server/arranque.js",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env dist/server/arranque.js",
    "alta": "node --env-file-if-exists=.env dist/server/alta.js",
    "verifica": "node --env-file-if-exists=.env dist/server/verifica.js",
    "baja": "node --env-file-if-exists=.env dist/server/baja.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "2.2.1",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.4",
    "fflate": "^0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.13.4",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
