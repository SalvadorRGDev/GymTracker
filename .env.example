# SIGIR Fitness — copia a .env y rellena. .env nunca va a git.
# `npm start`, `npm run alta` y `npm run verifica` lo leen solos (node --env-file-if-exists).

# 32 caracteres o más, aleatorios:  openssl rand -hex 32
# Firma las huellas de sesión y de captura. Cambiarlo cierra TODAS las sesiones y
# anula TODAS las credenciales de los atajos: es el botón de pánico.
SESSION_SECRET=

# Dónde viven los libros de Excel. NUNCA lo apuntes al almacén real en un
# experimento: un libro corrompido no tiene deshacer.
DATOS_DIR=datos

# Escucha sólo en local: quien lo publica es el túnel.
HOST=127.0.0.1
PORT=3000

# Proxy en el que se confía para leer X-Forwarded-For (límites por IP).
# Vacío con HOST local = «loopback» (el cliente del túnel). Si abres HOST, es
# obligatorio: direcciones del proxy separadas por comas, «loopback» o «none».
TRUSTED_PROXY=

# Duración deslizante de la sesión web, en horas (máximo absoluto: 90 días).
SESSION_TTL_HOURS=720

# El cliente compilado. Vacío = no servirlo (en desarrollo lo sirve Vite).
# Se publica por el túnel: nunca la raíz del proyecto ni nada que contenga
# DATOS_DIR (el servidor se niega a arrancar si lo contiene, y de aquí sólo sale
# lo que produce build:web).
WEB_DIR=dist/web

# https a donde mandar a reinstalar un atajo viejo (va en el cuerpo del 426).
ATAJOS_URL=

# La dirección https con la que el iPhone alcanza este servidor: la del túnel,
# sin ruta (https://sigir.tu-red.ts.net). Va en el credencial.json que emite
# Dispositivos. Vacía, se toma del navegador que emite, que acierta mientras
# emitas desde la URL del túnel; si el túnel reescribe Host y emites desde otro
# sitio, el archivo apuntaría a 127.0.0.1. La pantalla lo avisa al emitir.
URL_PUBLICA=

# Alta pública desde la web (ADR-020): «si» deja que cualquiera con el enlace
# se cree una cuenta; «no» (por omisión) deja sólo `npm run alta`.
ALTA_ABIERTA=no
# Con el alta abierta, cuántas cuentas admite el servidor como mucho (1–1000).
MAXIMO_DE_CUENTAS=20

# «silencio» apaga el registro de peticiones (el ensayo lo usa).
LOG=

# Sólo para deploy/respaldo.sh: huella GPG con la que cifrar el respaldo completo.
BACKUP_RECIPIENT=
