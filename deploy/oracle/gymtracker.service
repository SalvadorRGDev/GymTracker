# Servicio de usuario: ~/.config/systemd/user/gymtracker.service
# Lo instala deploy/oracle/instala.sh. Se reinicia solo si el proceso cae (riesgo R8).
[Unit]
Description=GymTracker
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/gymtracker
ExecStart=/usr/bin/node --env-file=.env dist/server/arranque.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
